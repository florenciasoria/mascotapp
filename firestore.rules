rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ¿Hay un usuario logueado?
    function isSignedIn() {
      return request.auth != null;
    }

    // ¿El usuario logueado es el dueño de este documento?
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ¿Es un texto con un largo entre min y max?
    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // Campos comunes a todos los perfiles (mismos límites que validators.js)
    function hasValidCommonFields(data) {
      return isText(data.name, 2, 80)
        && isText(data.phone, 6, 20)
        && isText(data.address, 5, 200);
    }

    // Perfil de adoptante: entra aprobado directamente
    function isValidAdopter(data) {
      return data.role == 'adoptante'
        && data.status == 'aprobado'
        && data.keys().hasOnly(['role', 'status', 'name', 'email', 'phone', 'address', 'createdAt']);
    }

    // Perfil de refugio: arranca pendiente hasta que lo apruebe un admin
    function isValidShelter(data) {
      return data.role == 'refugio'
        && data.status == 'pendiente'
        && isText(data.about, 10, 500)
        && isText(data.neighborhood, 2, 40)
        && data.keys().hasOnly(['role', 'status', 'name', 'email', 'phone', 'address', 'neighborhood', 'about', 'createdAt']);
    }

    // Edición del perfil: cada rol solo puede modificar sus propios campos
    function isValidProfileUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return hasValidCommonFields(data) && (
        (resource.data.role == 'refugio'
          && changed.hasOnly(['name', 'phone', 'address', 'neighborhood', 'about'])
          && isText(data.neighborhood, 2, 40)
          && isText(data.about, 10, 500))
        || (resource.data.role != 'refugio'
          && changed.hasOnly(['name', 'phone', 'address']))
      );
    }

    // ¿El usuario verificó su email?
    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    // Perfil del usuario logueado (se lee de la base para conocer su rol y estado)
    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // ¿Usuario logueado, verificado, aprobado y con este rol?
    function isApprovedRole(role) {
      return isSignedIn() && isVerified()
        && currentUser().role == role
        && currentUser().status == 'aprobado';
    }

    function isAdmin() {
      return isApprovedRole('admin');
    }

    // Cambio de estado hecho por el admin: solo el estado (y su fecha),
    // a un valor válido, y nunca sobre su propia cuenta
    function isValidStatusChange(userId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return request.auth.uid != userId
        && changed.hasOnly(['status', 'statusUpdatedAt'])
        && data.status in ['aprobado', 'rechazado', 'inactivo']
        && data.statusUpdatedAt == request.time
        // Solo se aprueba (o reactiva) una cuenta con el email verificado
        && (data.status != 'aprobado' || resource.data.emailVerified == true);
    }

    // El usuario registra en su perfil que verificó el email
    // (solo puede poner true, y solo si Firebase lo confirma)
    function isEmailVerifiedSync() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['emailVerified'])
        && data.emailVerified == true
        && isVerified();
    }
  
    // Datos de una mascota (mismas listas y límites que petOptions.js y validators.js)
    function isValidPet(data) {
      return isText(data.name, 2, 40)
        && data.species in ['Perro', 'Gato']
        && isText(data.breed, 2, 40)
        && data.sex in ['Macho', 'Hembra']
        && data.ageValue is int && data.ageValue >= 0 && data.ageValue <= 30
        && ((data.ageUnit == 'meses' && data.ageInMonths == data.ageValue)
          || (data.ageUnit == 'años' && data.ageInMonths == data.ageValue * 12))
        && data.size in ['Pequeño', 'Mediano', 'Grande']
        && data.color in ['Negro', 'Blanco', 'Gris', 'Marrón', 'Naranja', 'Atigrado', 'Tricolor', 'Mixto']
        && isText(data.imageUrl, 20, 1000)
        && data.imageUrl.matches('https://firebasestorage[.]googleapis[.]com/.*')
        && isText(data.imageStoragePath, 10, 200)
        && data.imageStoragePath.matches('pets/' + request.auth.uid + '/.*')
        && isText(data.description, 10, 500)
        && data.updatedAt == request.time;
    }

    // Edición de una mascota por su refugio
    function isValidPetUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return resource.data.shelterId == request.auth.uid
        && resource.data.status != 'adoptada'
        && data.status in ['disponible', 'no_disponible']
        && changed.hasOnly(['name', 'species', 'breed', 'sex', 'ageValue', 'ageUnit',
             'ageInMonths', 'size', 'color', 'imageUrl', 'imageStoragePath', 'description',
             'status', 'shelterName', 'neighborhood', 'shelterAddress', 'updatedAt'])
        // Los datos del refugio copiados en la mascota solo pueden actualizarse a los de su perfil
        && (!changed.hasAny(['shelterName']) || data.shelterName == currentUser().name)
        && (!changed.hasAny(['neighborhood']) || data.neighborhood == currentUser().neighborhood)
        && (!changed.hasAny(['shelterAddress']) || data.shelterAddress == currentUser().address)
        && isValidPet(data);
    }

    // El admin pausa las mascotas disponibles de un refugio que desactiva
    // (solo puede pasarlas de disponible a no disponible)
    function isAdminPetPause() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return resource.data.status == 'disponible'
        && data.status == 'no_disponible'
        && changed.hasOnly(['status', 'updatedAt'])
        && data.updatedAt == request.time;
    }

    // El refugio marca su mascota como adoptada al aceptar una solicitud (aunque esté pausada).
    // La solicitud indicada tiene que ser de esta mascota y quedar aceptada en la misma operación.
    function isPetAdoption(petId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      let acceptedRequest = getAfter(/databases/$(database)/documents/adoptionRequests/$(data.adoptionRequestId)).data;
      return resource.data.shelterId == request.auth.uid
        && resource.data.status in ['disponible', 'no_disponible']
        && data.status == 'adoptada'
        && changed.hasOnly(['status', 'adoptionRequestId', 'updatedAt'])
        && data.updatedAt == request.time
        && acceptedRequest.petId == petId
        && acceptedRequest.status == 'aceptada';
    }

    // Respuestas del formulario de solicitud (mismas listas y límites que requestOptions.js y validators.js)
    function isValidRequestAnswers(answers) {
      return answers.keys().hasOnly(['housingType', 'hoursAlone', 'householdMembers',
             'hasYard', 'hasSafetyNet', 'hasOtherPets', 'otherPetsDetail',
             'hasExperience', 'experienceYears', 'aboutAdopter', 'motivation'])
        && answers.housingType in ['Departamento', 'Casa', 'PH']
        && answers.hoursAlone in ['Menos de 2 horas', '2 a 4 horas', '4 a 6 horas',
             '6 a 8 horas', 'Más de 8 horas']
        && isText(answers.householdMembers, 2, 200)
        && answers.hasYard is bool
        && answers.hasOtherPets is bool
        && answers.hasExperience is bool
        // Preguntas de seguimiento: obligatorias si respondió "Sí", prohibidas si respondió "No"
        && ((answers.hasYard && answers.get('hasSafetyNet', null) is bool)
          || (!answers.hasYard && !('hasSafetyNet' in answers)))
        && ((answers.hasOtherPets && isText(answers.get('otherPetsDetail', null), 2, 100))
          || (!answers.hasOtherPets && !('otherPetsDetail' in answers)))
        && ((answers.hasExperience
             && answers.get('experienceYears', null) in ['Menos de 1 año', '1 a 5 años', 'Más de 5 años'])
          || (!answers.hasExperience && !('experienceYears' in answers)))
        && isText(answers.aboutAdopter, 10, 1000)
        && isText(answers.motivation, 10, 1000);
    }

    // Alta de una solicitud: la mascota tiene que estar disponible y los datos
    // copiados tienen que coincidir con los reales
    function isValidNewRequest(requestId) {
      let data = request.resource.data;
      let pet = get(/databases/$(database)/documents/pets/$(data.petId)).data;
      return requestId == data.petId + '_' + request.auth.uid
        && data.adopterId == request.auth.uid
        && data.adopterName == currentUser().name
        && data.adopterContact == {
             'email': currentUser().email,
             'phone': currentUser().phone
           }
        && pet.status == 'disponible'
        && data.shelterId == pet.shelterId
        && data.shelterName == pet.shelterName
        && data.pet == {
             'name': pet.name,
             'species': pet.species,
             'breed': pet.breed,
             'ageValue': pet.ageValue,
             'ageUnit': pet.ageUnit,
             'imageUrl': pet.imageUrl
           }
        && isValidRequestAnswers(data.answers)
        && data.status == 'pendiente'
        && data.createdAt == request.time
        && data.keys().hasOnly(['petId', 'shelterId', 'shelterName', 'adopterId', 'adopterName',
             'adopterContact', 'pet', 'answers', 'status', 'createdAt']);
    }

    // El adoptante cancela su solicitud: solo una pendiente, y solo cambia el estado (y su fecha)
    function isAdopterCancel() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return resource.data.adopterId == request.auth.uid
        && resource.data.status == 'pendiente'
        && data.status == 'cancelada'
        && changed.hasOnly(['status', 'resolvedAt'])
        && data.resolvedAt == request.time;
    }

    // El adoptante marca como vista la respuesta del refugio (deja de ser novedad)
    function isAdopterSeen() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return resource.data.adopterId == request.auth.uid
        && resource.data.seenByAdopter == false
        && data.seenByAdopter == true
        && changed.hasOnly(['seenByAdopter']);
    }

    // El refugio acepta o rechaza una solicitud pendiente de una de sus mascotas.
    // Queda como novedad para el adoptante (seenByAdopter = false).
    function isShelterDecision(requestId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      let petAfter = getAfter(/databases/$(database)/documents/pets/$(resource.data.petId)).data;
      return resource.data.shelterId == request.auth.uid
        && resource.data.status == 'pendiente'
        && data.status in ['aceptada', 'rechazada']
        && changed.hasOnly(['status', 'resolvedAt', 'seenByAdopter', 'autoRejected'])
        && data.resolvedAt == request.time
        && data.seenByAdopter == false
        // Aceptar: la mascota tiene que quedar adoptada por ESTA solicitud
        && (data.status == 'rechazada'
          || (petAfter.status == 'adoptada' && petAfter.adoptionRequestId == requestId))
        // Rechazo automático: solo si la mascota quedó adoptada por OTRA solicitud
        && (!('autoRejected' in data)
          || (data.status == 'rechazada' && data.autoRejected == true
            && petAfter.status == 'adoptada' && petAfter.adoptionRequestId != requestId));
    }

    // Calificación de una adopción: solo el adoptante de una solicitud aceptada,
    // una sola vez (el ID es el de la solicitud) y con los datos copiados correctos
    function isValidNewRating(ratingId) {
      let data = request.resource.data;
      let adoption = get(/databases/$(database)/documents/adoptionRequests/$(ratingId)).data;
      return adoption.adopterId == request.auth.uid
        && adoption.status == 'aceptada'
        && data.adopterId == request.auth.uid
        && data.adopterName == adoption.adopterName
        && data.shelterId == adoption.shelterId
        && data.petName == adoption.pet.name
        && data.shelterScore is int && data.shelterScore >= 1 && data.shelterScore <= 5
        && data.processScore is int && data.processScore >= 1 && data.processScore <= 5
        && isText(data.comment, 0, 500)
        && data.createdAt == request.time
        && data.keys().hasOnly(['adopterId', 'adopterName', 'shelterId', 'petName',
             'shelterScore', 'processScore', 'comment', 'createdAt']);
    }

    // Perfiles de usuario: el ID del documento es el uid de Authentication
    match /users/{userId} {
      // Cada usuario lee su perfil; el admin, todos
      allow read: if isOwner(userId) || isAdmin();

      // Alta: nunca admin, el email debe ser el de la cuenta,
      // la fecha la pone el servidor y los campos deben ser válidos
      allow create: if isOwner(userId)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && hasValidCommonFields(request.resource.data)
        && (isValidAdopter(request.resource.data) || isValidShelter(request.resource.data));

      // Edición: el usuario, sus datos de contacto o su email verificado; el admin, solo el estado
      allow update: if (isOwner(userId) && (isValidProfileUpdate() || isEmailVerifiedSync()))
        || (isAdmin() && isValidStatusChange(userId));

      allow delete: if false;
    }

    // Calificaciones. ID = ID de la solicitud aceptada (una sola por adopción)
    match /ratings/{ratingId} {
      // Adoptante: las suyas. Refugio: las que recibió. Admin: todas.
      allow read: if isSignedIn() && isVerified() && (
        resource.data.adopterId == request.auth.uid
        || resource.data.shelterId == request.auth.uid
        || isAdmin()
      );

      // Alta: solo el adoptante de una adopción aceptada
      allow create: if isApprovedRole('adoptante') && isValidNewRating(ratingId);

      // Una vez enviada, no se edita ni se borra
      allow update, delete: if false;
    }

    // Mascotas
    match /pets/{petId} {
      // Adoptantes: solo disponibles. Refugio: las suyas. Admin: todas.
      allow read: if isSignedIn() && isVerified() && (
        resource.data.status == 'disponible'
        || resource.data.shelterId == request.auth.uid
        || isAdmin()
      );

      // Alta: solo un refugio aprobado, a su nombre y como disponible
      allow create: if isApprovedRole('refugio')
        && request.resource.data.shelterId == request.auth.uid
        && request.resource.data.shelterName == currentUser().name
        && request.resource.data.neighborhood == currentUser().neighborhood
        && request.resource.data.shelterAddress == currentUser().address
        && request.resource.data.status == 'disponible'
        && request.resource.data.createdAt == request.time
        && isValidPet(request.resource.data)
        && request.resource.data.keys().hasOnly(['name', 'species', 'breed', 'sex', 'ageValue',
             'ageUnit', 'ageInMonths', 'size', 'color', 'imageUrl', 'imageStoragePath', 'description',
             'shelterId', 'shelterName', 'neighborhood', 'shelterAddress', 'status', 'createdAt', 'updatedAt']);

      // Edición: el refugio dueño (nunca una adoptada) o marcarla adoptada al aceptar
      // una solicitud; el admin, solo pausar
      allow update: if (isApprovedRole('refugio') && (isValidPetUpdate() || isPetAdoption(petId)))
        || (isAdmin() && isAdminPetPause());

      allow delete: if false;
    }

    // Solicitudes de adopción. ID = {petId}_{adopterId} (impide duplicadas)
    match /adoptionRequests/{requestId} {
      // Adoptante: las suyas. Refugio: las que recibió. Admin: todas.
      allow read: if isSignedIn() && isVerified() && (
        resource.data.adopterId == request.auth.uid
        || resource.data.shelterId == request.auth.uid
        || isAdmin()
      );

      // Alta: solo un adoptante aprobado, a su nombre, para una mascota disponible
      allow create: if isApprovedRole('adoptante') && isValidNewRequest(requestId);

      // Adoptante dueño: cancelar una pendiente, marcar una respuesta como vista
      // o volver a solicitar una cancelada. Refugio dueño: aceptar o rechazar una pendiente.
      allow update: if (isApprovedRole('adoptante') && (
          isAdopterCancel()
          || isAdopterSeen()
          || (resource.data.adopterId == request.auth.uid
            && resource.data.status == 'cancelada'
            && isValidNewRequest(requestId))
        ))
        || (isApprovedRole('refugio') && isShelterDecision(requestId));

      allow delete: if false;
    }

    // Cualquier otra ruta queda denegada: Firestore bloquea
    // todo lo que no esté permitido explícitamente.
  }
}